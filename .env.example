# PostgreSQL connection used by Drizzle (run log / reports)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set to 0 to disable live CelesTrak fetches (air-gapped use; bundled snapshot is used instead)
ORBITAL_GUARD_LIVE_TLE=1
# Logging verbosity for the API: debug | info | warn | error
ORBITAL_GUARD_LOG_LEVEL=info
# Optional: where the Python scripts keep datasets (defaults to ml/data)
# ORBITAL_GUARD_DATA_DIR=/data/orbital-guard
